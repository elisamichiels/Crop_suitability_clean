  for(i in 2:ncol(x)) {
    smp_size = floor(0.9*nrow(x))
    
    train_ind = sample(seq_len(nrow(x)), size=smp_size)
    training = x[train_ind, -c(i)]
    testing = x[-train_ind, -c(i)]
    
#    tune.out.radial = tune(svm, durum~., data=training,
#                   scale = TRUE,
#                   type = "C-classification",
#                   kernel = 'radial', 
#                   ranges=list(gamma=c(0.1,3), cost=c(0.1,3)),
#                   probability = TRUE)
    
    svm.radial = svm(durum~., data=training, 
                     scale = TRUE,
                     type = "C-classification",
                     gamma = 3, #tune.out.radial[["best.parameters"]][["gamma"]], 
                     cost = 3, # tune.out.radial[["best.parameters"]][["cost"]], 
                     kernel = 'radial', 
                     probability = TRUE)
    
    train.pred.radial = predict(svm.radial, testing)
    testing_y = as.factor(testing$durum)
    conf.matrix.svm.radial = confusionMatrix(train.pred.radial, testing_y)
    varimp_df = rbind(varimp_df, data.frame(
